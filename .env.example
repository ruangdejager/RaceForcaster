# --- REQUIRED -------------------------------------------------------------
# MET Norway's terms of service require every request to identify itself with
# an application name and a way to contact you. Requests without this get a
# 403. Use your own domain/repo and email here.
#   https://api.met.no/doc/TermsOfService
MET_USER_AGENT="RaceForecaster/0.1 github.com/yourname/RaceForecaster you@example.com"

# --- OPTIONAL -------------------------------------------------------------
# Port the API listens on (also serves the built web app in production).
PORT=8787

# Where the SQLite database and uploaded routes live. Mounted as a volume in
# docker-compose so saved plans and the weather cache survive restarts.
DATA_DIR=./data

# Public origin, used to build share links. No trailing slash.
PUBLIC_BASE_URL=http://localhost:8787

# Max met.no requests per second we allow ourselves. Their limit is 20/s;
# staying well under it is the polite thing to do and plenty fast since we
# cache aggressively.
MET_MAX_RPS=5
